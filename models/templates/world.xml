<mujoco model="micromouse">

    <compiler angle="degree"/>

    <option
        gravity="0 0 -9.81"
        timestep="0.002"
    />

    <visual>
        <headlight diffuse="0.8 0.8 0.8"/>
    </visual>

    <asset>

        <texture
            name="grid"
            type="2d"
            builtin="checker"
            width="512"
            height="512"
            rgb1="0.2 0.2 0.2"
            rgb2="0.3 0.3 0.3"/>

        <material
            name="floor"
            texture="grid"/>

    </asset>

    <worldbody>

        <light
            pos="0 0 5"/>

        <geom
            name="floor"
            type="plane"
            size="10 10 .1"
            material="floor"/>

    </worldbody>

</mujoco>